# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase connection used by the production Auth and data client.
# Vite reads these values at build time. Keep the file with real values as
# .env.local (ignored by git), then rebuild before running npm run preview.
# Use a publishable/anon key only; never expose a service-role key in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Safe Creator Space QA boundary. Keep `mock` until manual UI QA is complete.
# Change to `supabase` only for an explicitly approved persistence test.
VITE_PERSISTENCE_MODE=mock

# GO 4 Works Read rollout flag. Keep unset or set to "supabase" by default;
# set to "google" only in an explicitly approved Vercel Preview deployment.
VITE_CXL_WORKS_READ_BACKEND=supabase

# GO 5A public profile/settings read rollout flag. Keep unset or set to
# "supabase" by default; set to "google" only in an approved Vercel Preview.
VITE_CXL_PUBLIC_CREATOR_READ_BACKEND=supabase

# GO 6A Owner Work create/edit Preview flag. Keep unset or "supabase" until
# Owner Auth and Preview write validation are explicitly approved.
VITE_CXL_WORKS_WRITE_BACKEND=supabase

# GO 3 server-only values for the Vercel /api/cxl/google function.
# Configure these in Vercel's server environment (and local .env.local for `vercel dev`).
# Never rename these to VITE_*; they must not be bundled into browser assets.
SUPABASE_URL=
SUPABASE_ANON_KEY=
CXL_GAS_PUBLIC_URL=
CXL_GAS_OWNER_URL=
CXL_OWNER_USER_ID=
CXL_API_SHARED_SECRET=

# Explicitly enables standard Google Work media reads/uploads in Production.
# Preview remains enabled for validation without this flag. POC/repair routes stay Preview-only.
CXL_GOOGLE_WORK_MEDIA_ENABLED=0
