// Cloudflare Workers deploy (Static Assets + the /api/cxl/* handlers).
// Build first with `npm run build`; secrets and settings live in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cxlstudio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // node:crypto, Buffer and process.env for the shared Node handlers.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/work/*", "/@*"]
  },
  "observability": { "enabled": true },
  // Copies of Drive images, filled as they are served (src/server/mediaObjectCache.ts).
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "cxl-media" }],
  // Copies of the Sheets/Drive sources the API reads (src/server/cxlSourceStore.ts).
  "d1_databases": [{ "binding": "DATA_DB", "database_name": "cxl-data", "database_id": "feaa5c0a-64ce-47a1-884a-c7a8ae5d3013" }],
  // Branch and pull request builds run `wrangler preview`, which needs this block.
  "previews": {},
  // Keep the dashboard's variables and secrets on deploy (they are not listed here).
  "keep_vars": true
}
